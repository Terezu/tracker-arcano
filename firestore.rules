rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && exists(/databases/$(database)/documents/membros/$(uid))
        && get(/databases/$(database)/documents/membros/$(uid)).data.ativo == true;
    }
    function smallString(value, max) { return value is string && value.size() > 0 && value.size() <= max; }
    function iso(value) { return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$'); }
    function date(value) {
      return value is string && value >= '1900-01-01' && value <= '2100-12-31'
        && (value.matches('^[0-9]{4}-((01|03|05|07|08|10|12)-(0[1-9]|[12][0-9]|3[01])|(04|06|09|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-8]))$')
        || value.matches('^((19|20)(0[48]|[2468][048]|[13579][26])|2000)-02-29$'));
    }
    match /membros/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /usuarios/{uid} {
      allow get: if owner(uid);
      allow create: if owner(uid) && request.resource.data.keys().hasOnly(['nome','criadoEm','atualizadoEm'])
        && smallString(request.resource.data.nome,80)
        && request.resource.data.criadoEm == request.time && request.resource.data.atualizadoEm == request.time;
      allow update: if owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome','atualizadoEm'])
        && smallString(request.resource.data.nome,80) && request.resource.data.atualizadoEm == request.time;
      match /preferencias/interface {
        allow get: if owner(uid);
        // UX acknowledgement only; never used as a security proof of password change.
        allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['senhaTrocadaNaInterface'])
          && request.resource.data.senhaTrocadaNaInterface == true;
      }
      match /decks/{deckId} {
        function shape() { return request.resource.data.keys().hasOnly(['nome','atual','arquivado'])
          && smallString(request.resource.data.nome,80) && smallString(request.resource.data.atual,128)
          && request.resource.data.arquivado is bool; }
        function newVersion() {
          let v = request.resource.data.atual;
          return !exists(/databases/$(database)/documents/usuarios/$(uid)/decks/$(deckId)/versoes/$(v))
            && getAfter(/databases/$(database)/documents/usuarios/$(uid)/decks/$(deckId)/versoes/$(v)).data.deckId == deckId;
        }
        allow get: if owner(uid);
        allow list: if owner(uid) && request.query.limit <= 100;
        allow create: if owner(uid) && shape() && newVersion();
        allow update: if owner(uid) && shape() && (request.resource.data.atual == resource.data.atual || newVersion());
        allow delete: if false;
        match /versoes/{versionId} {
          allow get: if owner(uid);
          allow create: if owner(uid)
            && request.resource.data.keys().hasOnly(['deckId','texto','validacao','criadoEm'])
            && request.resource.data.deckId == deckId && smallString(request.resource.data.texto,30000)
            && iso(request.resource.data.criadoEm)
            && request.resource.data.validacao is map
            && request.resource.data.validacao.keys().hasOnly(['entries','errors','checkedAt'])
            && request.resource.data.validacao.entries is list
            && request.resource.data.validacao.entries.size() > 0 && request.resource.data.validacao.entries.size() <= 200
            && request.resource.data.validacao.errors == [] && iso(request.resource.data.validacao.checkedAt)
            && getAfter(/databases/$(database)/documents/usuarios/$(uid)/decks/$(deckId)).data.atual == versionId;
          allow update, delete, list: if false;
        }
      }
      match /partidas/{matchId} {
        function shape() {
          let d = request.resource.data;
          return d.keys().hasOnly(['deckId','versaoId','data','placar','criadoEm'])
            && smallString(d.deckId,128) && smallString(d.versaoId,128) && date(d.data) && iso(d.criadoEm)
            && d.placar in ['2-0','2-1','1-1','1-2','0-2','1-0','0-1','0-0']
            && exists(/databases/$(database)/documents/usuarios/$(uid)/decks/$(d.deckId))
            && get(/databases/$(database)/documents/usuarios/$(uid)/decks/$(d.deckId)/versoes/$(d.versaoId)).data.deckId == d.deckId;
        }
        allow get: if owner(uid);
        allow list: if owner(uid) && request.query.limit <= 50;
        allow create: if owner(uid) && shape()
          && get(/databases/$(database)/documents/usuarios/$(uid)/decks/$(request.resource.data.deckId)).data.arquivado == false
          && get(/databases/$(database)/documents/usuarios/$(uid)/decks/$(request.resource.data.deckId)).data.atual == request.resource.data.versaoId;
        allow update: if owner(uid) && shape() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data','placar']);
        allow delete: if owner(uid);
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
